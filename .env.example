# ==============================================================================
# ROYAL MOMENTS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend)
# Accessible in the browser via import.meta.env
# ------------------------------------------------------------------------------

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anonymous Public Key (Project Settings -> API -> Anon Public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Family Passcode required to upload files (Leave empty for open family uploads)
VITE_UPLOAD_PASSCODE=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ENVIRONMENT VARIABLES (Vercel Serverless Functions)
# Used only by /api/create-upload-url. NEVER exposed to frontend bundles!
# ------------------------------------------------------------------------------

# Supabase Project URL for serverless backend
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (Project Settings -> API -> service_role secret)
# CAUTION: Never commit or expose this key to client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional server-side secret that matches VITE_UPLOAD_PASSCODE if passcode verification is enabled
UPLOAD_ACCESS_SECRET=
